{
  "name": "sitac-core",
  "version": "1.1.0",
  "description": "Stable-Identity Temporal Audit Chain — production-ready copy-before-write versioning with stable foreign keys, restoration that preserves deletion evidence, and child-table archival. Designed to support auditability and compliance controls relevant to ISO 27001, SOC 2®, and UK GDPR. Supports MySQL and PostgreSQL.",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "require": "./src/index.js",
      "types": "./src/index.d.ts"
    },
    "./postgres": {
      "require": "./src/postgres.js",
      "types": "./src/index.d.ts"
    },
    "./mysql": {
      "require": "./src/index.js",
      "types": "./src/index.d.ts"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "echo \"No linter configured yet\""
  },
  "keywords": [
    "audit",
    "versioning",
    "temporal",
    "soft-delete",
    "history",
    "compliance",
    "iso27001",
    "soc2",
    "gdpr",
    "mysql",
    "postgresql",
    "postgres",
    "copy-before-write",
    "stable-identity"
  ],
  "author": "Paul Emerton",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/verifie/sitac.git"
  },
  "bugs": {
    "url": "https://github.com/verifie/sitac/issues"
  },
  "homepage": "https://github.com/verifie/sitac#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "peerDependencies": {
    "mysql2": ">=2.0.0",
    "pg": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "files": [
    "src/",
    "docs/",
    "LICENSE",
    "README.md"
  ]
}
